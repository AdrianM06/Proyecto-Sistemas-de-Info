rules_version = '2';

// Reglas de Firebase Storage de Samán Deportivo.
//
// Fotos de perfil en usuarios/{uid}/perfil_<fecha>.<jpg|png|webp>:
// - Solo el dueño puede subir, cambiar o borrar su foto.
// - Solo imágenes JPG, PNG o WEBP de hasta 2 MB.
// - Cualquier usuario con sesión puede verlas (la app muestra la foto con su
//   URL de descarga).
// Todo lo demás queda cerrado.
service firebase.storage {
  match /b/{bucket}/o {

    match /usuarios/{uid}/{archivo} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && archivo.matches('perfil_[0-9]+[.](jpg|png|webp)')
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
